<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- the release workflow sets VersionSuffix (e.g. "alpha.1") for pre-releases -->
    <VersionPrefix>3.6.1.0</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Contact Conversion Wizard contributors</Company>
    <Product>Contact Conversion Wizard</Product>
    <Copyright>Copyright © NV-Systems 2013, Contact Conversion Wizard contributors</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
