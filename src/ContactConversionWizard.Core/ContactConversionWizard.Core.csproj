    <RootNamespace>ContactConversionWizard.Core</RootNamespace>
    <AssemblyName>ContactConversionWizard.Core</AssemblyName>
    <Description>Import, clean-up and export logic of the Contact Conversion Wizard, independent of the user interface.</Description>
